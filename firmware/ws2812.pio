; WS2812B driver for the rev F status pixel.  The canonical program from
; pico-examples (BSD-3-Clause, Raspberry Pi (Trading) Ltd), 10 cycles per
; bit: the C side sets the clock divider for 800 kHz.
;
; This runs on pio1.  Serving owns pio0 -- both its state machines and its
; instruction memory -- and the two blocks share nothing, so a cosmetic job
; on core 0 cannot reach the bus timing on core 1 even by accident.  That
; separation is deliberate: the whole licence for a CPU-in-the-loop ROM
; emulator is that its replies land in time, and the status light is the one
; part of this firmware that has no business being anywhere near that.

.program ws2812
.side_set 1

.define public T1 3
.define public T2 3
.define public T3 4

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]
    jmp !x do_zero side 1 [T1 - 1]
do_one:
    jmp  bitloop   side 1 [T2 - 1]
do_zero:
    nop            side 0 [T2 - 1]
.wrap
