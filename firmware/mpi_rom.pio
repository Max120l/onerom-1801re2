; MPI (Soviet Q-bus equivalent) ROM slave, for RP2350 PIO.
;
; Two state machines split the job:
;
;   mpi_capture  snapshots the whole 24-bit GPIO field on the leading edge of
;                nSYNC, when the multiplexed bus carries the address.
;
;   mpi_respond  waits for nDIN, drives the data the CPU handed it, and pulls
;                nRPLY low to complete the handshake.
;
; Both machines use IN base = GPIO 0 so that a pin index in a WAIT instruction
; is just the GPIO number.  Keep these three defines in step with
; board_fire24e.h; build_pin_masks() asserts that they agree.

.define PUBLIC PIN_nSYNC   0
.define PUBLIC PIN_nDIN    0
.define PUBLIC PIN_nRPLY   0

; ---------------------------------------------------------------------------
; Address capture
; ---------------------------------------------------------------------------
;
; nSYNC is active low.  Waiting for it high first means a machine started
; mid-cycle resynchronises instead of latching garbage.
;
; The MPI address hold time after SYNC asserts is far longer than the ~20 ns it
; takes the input synchroniser plus one instruction to sample, so a snapshot
; taken immediately on the edge is comfortably inside the valid window.
;
; Configure: in base 0, in shift LEFT, autopush at 24 bits.

.program mpi_capture
.wrap_target
    wait 1 pin PIN_nSYNC        ; bus idle
    wait 0 pin PIN_nSYNC        ; address strobe -- address is on the AD lines
    in pins, 24                 ; snapshot GPIO 0..23, autopush to the CPU
.wrap

; ---------------------------------------------------------------------------
; Data response
; ---------------------------------------------------------------------------
;
; The CPU pushes one 24-bit word per cycle it intends to answer: the inverted
; data already scattered onto the right GPIOs, with the nRPLY bit low.  If the
; address was not ours the CPU pushes nothing and this machine simply stays
; blocked on PULL, so a non-matching cycle produces no bus activity at all.
;
; X and Y hold pin-direction masks, loaded at init:
;   X = AD lines as outputs, nRPLY still released
;   Y = X plus nRPLY as an output
;
; Driving the AD lines one instruction before nRPLY gives the host data setup
; time.  nRPLY is open-drain by construction: its output value is always 0, so
; enabling its direction pulls the line low and clearing the direction hands it
; back to the bus pull-up.  The line is never driven high.
;
; Configure: out base 0, out shift RIGHT, autopull disabled.

.program mpi_respond
.wrap_target
    mov osr, null
    out pindirs, 24             ; release the bus: AD and nRPLY hi-Z
    pull block                  ; drive pattern for this cycle, from the CPU
    wait 0 pin PIN_nDIN         ; read strobe
    out pins, 24                ; present data (nRPLY bit is low but still hi-Z)
    mov osr, x
    out pindirs, 24             ; drive the AD lines
    mov osr, y
    out pindirs, 24             ; assert nRPLY -- handshake complete
    wait 1 pin PIN_nDIN         ; host has taken the data
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void mpi_capture_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = mpi_capture_program_get_default_config(offset);
    sm_config_set_in_pins(&c, 0);
    sm_config_set_in_shift(&c, false /* shift left */, true /* autopush */, 24);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}

static inline void mpi_respond_init(PIO pio, uint sm, uint offset,
                                    uint32_t dirs_ad, uint32_t dirs_ad_rply) {
    pio_sm_config c = mpi_respond_program_get_default_config(offset);
    sm_config_set_in_pins(&c, 0);       // so WAIT PIN indices are GPIO numbers
    sm_config_set_out_pins(&c, 0, 24);
    sm_config_set_out_shift(&c, true /* shift right */, false /* no autopull */, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);

    // Preload the two direction masks into X and Y.
    pio_sm_put_blocking(pio, sm, dirs_ad);
    pio_sm_exec(pio, sm, pio_encode_pull(false, false));
    pio_sm_exec(pio, sm, pio_encode_mov(pio_x, pio_osr));
    pio_sm_put_blocking(pio, sm, dirs_ad_rply);
    pio_sm_exec(pio, sm, pio_encode_pull(false, false));
    pio_sm_exec(pio, sm, pio_encode_mov(pio_y, pio_osr));
}
%}
